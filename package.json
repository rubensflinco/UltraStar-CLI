{
  "name": "ultrastar-cli-plus",
  "description": "UltraStar CLI Plus — fork with language filter, native YouTube download, i18n, volume normalize and split audio/video",
  "version": "1.1.2",
  "type": "module",
  "private": true,
  "keywords": [
    "ultrastar",
    "ultrastar-cli-plus",
    "cli",
    "download",
    "songs",
    "karaoke"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rubensflinco/UltraStar-CLI"
  },
  "license": "MIT",
  "homepage": "https://github.com/rubensflinco/UltraStar-CLI",
  "scripts": {
    "build": "bun run --cwd src build.ts",
    "start": "bun run src/index.tsx",
    "format": "biome format --write .",
    "clean": "git clean -xdf .turbo build",
    "lint": "biome lint --write .",
    "bump": "bumpp"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@types/bun": "latest",
    "@types/ffmpeg-static": "^5.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.9",
    "bumpp": "^10.2.2",
    "chalk": "^5.5.0",
    "pretty-bytes": "^7.0.0",
    "react-devtools-core": "^6.1.5",
    "tinyglobby": "^0.2.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "effect": "^3.17.7",
    "env-paths": "^3.0.0",
    "ffmpeg-static": "^5.3.0",
    "i18next": "^26.3.6",
    "ink": "^6.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.1.1",
    "youtubei.js": "^18.0.0"
  }
}
